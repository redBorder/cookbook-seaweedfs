# Generated by Chef. Shared by every SeaweedFS service of the cluster (same keys in every node)

# Volume servers: writes and reads need a token signed by the master/filer
[jwt.signing]
key = "<%= @volume_write_key %>"
expires_after_seconds = 10

[jwt.signing.read]
key = "<%= @volume_read_key %>"
expires_after_seconds = 10

# Filer: its HTTP API and its IAM gRPC service need an admin token
[jwt.filer_signing]
key = "<%= @filer_write_key %>"
expires_after_seconds = 10

[jwt.filer_signing.read]
key = "<%= @filer_read_key %>"
expires_after_seconds = 10

[access]
ui = false
