# Generated by Chef. Options of seaweedfs-filer.service (filer + S3 gateway)
# The Iceberg and Lance ports of the S3 gateway and its IAM API are not used.
# The S3 gateway listens in every interface (nginx uses localhost:<s3 port> during the install),
# the firewall only opens it in the home zone
OPTIONS="-ip=<%= @ipaddress %> -ip.bind=<%= @ipaddress %> -port=<%= @port %> -master=<%= @masters %> -defaultReplicaPlacement=<%= @replication %> -s3 -s3.port=<%= @s3_port %> -s3.ip.bind=0.0.0.0 -s3.config=/etc/seaweedfs/s3.json -s3.iam=false -s3.port.iceberg=0 -s3.port.lance=0"
